  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WaterlineWater – surface, contact line, rain, surface sound</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.Material surfaceMaterial {"hint":"Lit material for the surface (cloned; made transparent at runtime)"}'
    - '// @input Asset.Material glowMaterial {"hint":"Unlit base material cloned for the contact line and ripple rings"}'
    - '// @input Asset.RenderMesh boxMesh {"hint":"1 cm unit box mesh (contact-line bars)"}'
    - '// @input SceneObject roomRoot {"hint":"Stand-in room root — its meshes get a contact line where the water meets them"}'
    - '// @input SceneObject belongingsRoot {"hint":"Belongings root — its meshes get a contact line too"}'
    - '// @input Asset.AudioTrackAsset rainTrack {"hint":"Rain loop played at the surface"}'
    - '// @input Asset.AudioTrackAsset rushTrack {"hint":"Low rushing-water loop played at the surface"}'
    - '// @input Asset.AudioTrackAsset underwaterTrack {"hint":"Muffled loop heard while the eyes are under the surface"}'
    - '// @input SceneObject floatersRoot {"hint":"Authored floating things (slipper, leaves): each child bobs on the surface at its authored X/Z"}'
    - '// @ui {"widget":"group_end"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"Settings"}'
    - '// @input vec4 waterColor = "{0.5, 0.84, 1.0, 0.42}" {"hint":"Surface colour and see-through amount (alpha). Keep it pale: black shows as transparent.", "widget":"color"}'
    - '// @input vec4 contactLineColor = "{0.85, 1.0, 1.0, 1.0}" {"hint":"Bright line where the water meets walls and furniture", "widget":"color"}'
    - '// @input float contactGlowAlpha = 0.35 {"hint":"Soft glow around the contact line (alpha)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @input float rippleAmplitudeCm = 0.8 {"hint":"Ripple height (cm)", "widget":"slider", "min":0, "max":2, "step":0.05}'
    - '// @input vec4 bodyTintColor = "{0.42, 0.8, 1.0, 0.3}" {"hint":"Unlit cyan-blue body tint under the lit surface (alpha = how see-through)", "widget":"color"}'
    - '// @input vec3 waterGlow = "{0.16, 0.38, 0.5}" {"hint":"Cyan glow the water adds on its own (keeps it light on an additive display)", "widget":"color"}'
    - '// @input float sparkleCount = 40 {"hint":"Small sparkles twinkling on the surface around the viewer", "widget":"slider", "min":0, "max":80, "step":1}'
    - '// @input float bobCm = 0.9 {"hint":"Floating things bob up and down by this much (cm)", "widget":"slider", "min":0, "max":3, "step":0.1}'
    - '// @input float rippleSpeed = 1 {"hint":"Ripple speed multiplier (1 = slow, calm swell)", "widget":"slider", "min":0.1, "max":3, "step":0.1}'
    - '// @input float rainRingCount = 22 {"hint":"Rain-drop rings on the surface at once", "widget":"slider", "min":0, "max":40, "step":1}'
    - '// @input float ambienceVolume = 0.7 {"hint":"Surface sound volume (rain + rush)", "widget":"slider", "min":0, "max":1, "step":0.05}'
    - '// @ui {"widget":"group_end"}'
