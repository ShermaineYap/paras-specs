  InputLines:
    - '// @ui {"widget":"label", "label":"<span style=\"color: #60A5FA;\">WaterlineGuidance – amber item, dotted line, pin, edge arrow</span>"}'
    - '// @ui {"widget":"separator"}'
    - '// @ui {"widget":"group_start", "label":"References"}'
    - '// @input Asset.Material glowMaterial {"hint":"Unlit base material cloned for dots and the arrow"}'
    - '// @input Asset.RenderMesh sphereMesh {"hint":"1 cm unit sphere mesh for the dotted line"}'
    - '// @input SceneObject edgeArrow {"hint":"Authored edge arrow object (mesh is built at runtime)"}'
